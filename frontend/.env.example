# API_URL is the only required value: the browser-reachable backend origin.
API_URL=http://localhost:8089/
# Optional. Defaults to the current browser origin when unset.
HOME_URL=http://localhost:3000
# Every value below is optional; missing integrations are disabled safely.
NODE_ENV=production
INVITATION_VIA_EMAIL=false
GOOGLE_TRACKING_ID=
GOOGLE_KEY=
CLOUD_VERSION=false
ENABLE_SSO=false
OAUTH2_PROVIDER=
LOGO_PATHS=
CUSTOM_COLORS=
BRAND_CONFIG=
DEMO_LINK=
PADDLE_SECRET_TOKEN=
PADDLE_ENVIRONMENT=production
RECAPTCHA_SITE_KEY=
LDAP_ENABLED=false
CLARITY_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
